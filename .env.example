# Database
MONGODB_URI=mongodb://localhost:27017/trao-interview-prep

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# LLM Configuration
# Provider choices: "gemini" | "openai" | "openrouter" | "mock"
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# SSRF Protection
# Set to "true" during local evaluation or batch testing against local servers (e.g., http://localhost:8099)
ALLOW_LOCAL_URLS=true

# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001
